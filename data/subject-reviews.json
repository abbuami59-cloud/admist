зЯрзЛржЬржи ржХрж░рзЗ ржерж╛ржХрзЗ ржпрж╛ ржЕржирзНржп ржЕржирзНржп ржХрзЛржи ржбрж┐ржкрж╛рж░рзНржЯржорзЗржирзНржЯ ржПржЦржиржУ ржХрж░рждрзЗ ржкрж╛рж░рзЗ ржирж┐ред ржЖрж░ ржорзЗржХрж╛ржирж┐ржХрж╛рж▓ ржбрзЗ? ржжрзБржЗ ржжрж┐ржиржмрзНржпрж╛ржкрзА ржП ржкрзНрж░рзЛржЧрзНрж░рж╛ржорждрзЛ рждрж░рзНржХ рж╕рж╛ржкрзЗржХрзНрж╖рзЗ ржХрзНржпрж╛ржорзНржкрж╛рж╕рзЗрж░ рж╕ржмржЪрзЗрзЯрзЗ ржмрзЬ ржкрзНрж░рзЛржЧрзНрж░рж╛ржо рж╣рж┐рж╕рзЗржмрзЗ рж╕рзНржмрзАржХрзГрждред ржбрж┐ржкрж╛рж░рзНржЯржорзЗржирзНржЯрзЗрж░ ржИржж ржЦрзНржпрж╛ржд ржП ржкрзНрж░рзЛржЧрзНрж░рж╛ржо ржЖржорж╛ржжрзЗрж░ ржЫрж╛рждрзНрж░, рж╢рж┐ржХрзНрж╖ржХ, ржХрж░рзНржоржХрж░рзНрждрж╛, ржХрж░рзНржоржЪрж╛рж░рзА рж╕ржмрзНржмрж╛ржЗржХрзЗ ржПржХ рж╕рзВржБрждрзЛрзЯ ржмрзЗржБржзрзЗ ржлрзЗрж▓рзЗред</p><p>ржпрж╛рж░ ржлрж▓рзЗ рж▓рзЗржЦрж╛ржкрзЬрж╛ ржЖрж░ ржЧржмрзЗрж╖ржгрж╛рж░ ржкрж╛рж╢рж╛ржкрж╛рж╢рж┐ ржЦрзЗрж▓рж╛ржзрзБрж▓рж╛ ржЖрж░ рж╕рж╛ржВрж╕рзНржХрзГрждрж┐ржХ ржХрзНрж╖рзЗрждрзНрж░рзЗржУ рж╢рж┐ржХрзНрж╖рж╛рж░рзНржерзАржжрзЗрж░ ржорзЗржзрж╛ ржмрж┐ржХрж╛рж╢рзЗрж░ ржпржерзЗрж╖рзНржЯ рж╕рзБржпрзЛржЧ ржерж╛ржХрзЗред ржлрж▓рзЗ ржПрж╕ржХрж▓ ржмрж┐рж╖рзЯ ржпрзЗржоржи ржмрж┐ржнрж┐ржирзНржи ржЦрзЗрж▓рж╛, ржкрзНрж░рзЛржЧрзНрж░рж╛ржо ржЕрж░рзНржЧрж╛ржирж╛ржЗржЬ, ржЗржнрзЗржирзНржЯ ржорзЗржирзЗржЬржорзЗржирзНржЯ, ржирж╛ржЪ, ржЧрж╛ржи, ржЕржнрж┐ржирзЯ, ржорж╛ржЗржо ржЗрждрзНржпрж╛ржжрж┐ ржмрж┐ржнрж┐ржирзНржи ржХрзНрж╖рзЗрждрзНрж░рзЗ ржХрзНржпрж╛ржорзНржкрж╛рж╕рзЗ ржорзЗржХрж╛ржирж┐ржХрж╛рж▓рзЗрж░ ржЫрзЗрж▓рзЗржорзЗрзЯрзЗржжрзЗрж░ рж░рзЯрзЗржЫрзЗ ржЖрж▓рж╛ржжрж╛ рж╕рзБржирж╛ржоред</p><p>ржПржЫрж╛рзЬрж╛ржУ ржЖржорж╛ржжрзЗрж░ ржХрзНржпрж╛ржорзНржкрж╛рж╕рзЗрж░ ржЫрж╛рждрзНрж░ рж╕ржВржЧржаржиржЧрзБрж▓рзЛ ржпрзЗржоржи рж╕рж╛ржВрж╕рзНржХрзГрждрж┐ржХ (ржЬрзЯржзрзНржмржирж┐, ржбрж┐ржмрзЗржЯрж┐ржВ рж╕рзЛрж╕рж╛ржЗржЯрж┐), ржЧржмрзЗрж╖ржгрж╛ржзрж░рзНржорзА (RMA, ASRRO), рж░рж╛ржЬржирзИрждрж┐ржХ (ржЫрж╛рждрзНрж░рж▓рзАржЧ, ржЫрж╛рждрзНрж░ ржЗржЙржирж┐рзЯржи) ржПржмржВ ржЕржирзНржпрж╛ржирзНржп ржЫрж╛рждрзНрж░ рж╕ржВржЧржаржиржЧрзБрж▓рзЛрждрзЗржУ (ржЧрзНрж░рж┐ржи ржлрж░ ржкрж┐рж╕, ржХрзНржпрж╛рж░рж┐рзЯрж╛рж░ ржХрзНрж▓рж╛ржм, рж╕рж╛ржВржмрж╛ржжрж┐ржХ рж╕ржорж┐рждрж┐, ржлржЯрзЛржЧрзНрж░рж╛ржлрж┐ржХ рж╕рзЛрж╕рж╛ржЗржЯрж┐, ржлрж┐рж▓рзНржо рж╕рзЛрж╕рж╛ржЗржЯрж┐, рж╕рзНржкрзЛрж░рзНржЯрж╕ ржХрзНрж▓рж╛ржм ржУ ржЕржирзНржпрж╛ржирзНржп) ржорзЗржХрж╛ржирж┐ржХрж╛рж▓рзЗрж░ ржЫрзЗрж▓рзЗ ржорзЗрзЯрзЗржжрзЗрж░ рж░рзЯрзЗржЫрзЗ рж╕рзНржмржЪрзНржЫржирзНржж ржЙржкрж╕рзНржерж┐рждрж┐ред</p><p>ржЖржЪрзНржЫрж╛ ржПрждржХрзНрж╖ржг рждрзЛ ржЖржорж╛ржжрзЗрж░ ржХрзНржпрж╛ржорзНржкрж╛рж╕ рж▓рж╛ржЗржл ржирж┐рзЯрзЗржЗ рж╕ржм ржХржерж╛ ржмрж▓рж▓рж╛ржоред рждрзЛ ржЧрзНрж░тАНрзНржпрж╛ржЬрзБрзЯрзЗрж╢ржи рж╢рзЗрж╖ ржХрж░рж╛рж░ ржкрж░ ржХрж┐ ржХрж░ржмрзЗ ржмрж╛ ржХрж┐ ржХрж┐ ржХрж░рж╛рж░ рж╕рзБржпрзЛржЧ ржЖржЫрзЗ рж╕рзЗржЯрж╛ ржирж┐рзЯрзЗ ржирж┐рж╢рзНржЪрзЯржЗ ржПрждржХрзНрж╖ржгрзЗ ржЪрж┐ржирзНрждрж╛ ржХрж░рж╛ рж╢рзБрж░рзБ ржХрж░рзЗ ржжрж┐рзЯрзЗржЫрзЛред рждрзЛ ржЪрж▓ ржПржЦржи ржЖржорж╛ржжрзЗрж░ ржХрзНржпрж╛рж░рж┐рзЯрж╛рж░ ржЧрзЬрж╛рж░ ржХрж┐ ржХрж┐ ржХрзНрж╖рзЗрждрзНрж░ рж░рзЯрзЗржЫрзЗ рж╕рзЗржЧрзБрж▓рзЛ рж╕ржорзНржкрж░рзНржХрзЗ ржПржХржЯрзБ ржЬрзЗржирзЗ ржирзЗржЗред</p><p>рж╕рж╛ржмрж▓рж┐рж▓ ржУ рж╕рзНржмржЪрзНржЫржирзНржж ржХрзНржпрж╛рж░рж┐рзЯрж╛рж░ ржЧрзЬрж╛рж░ ржкрзНрж░ржержо рж╕рзБржпрзЛржЧржЯрж╛ рждрзЛржорж╛ржХрзЗ ржЕржмрж╢рзНржп ржбрж┐ржкрж╛рж░рзНржЯржорзЗржирзНржЯ ржерзЗржХрзЗржЗ ржЕржлрж╛рж░ ржХрж░рж╛ рж╣ржмрзЗред ржкрзНрж░рждрж┐ ржмрзНржпрж╛ржЪ ржерзЗржХрзЗржЗ ржнрж╛рж▓ ржлрж▓рж╛ржлрж▓ ржЕрж░рзНржЬржиржХрж╛рж░рзА ржЫрзЗрж▓рзЗ ржорзЗрзЯрзЗрж░рж╛ ржбрж┐ржкрж╛рж░рзНржЯржорзЗржирзНржЯрзЗ рж▓рзЗржХржЪрж╛рж░рж╛рж░ рж╣рж┐рж╕рзЗржмрзЗ ржЬрзЯрзЗржи ржХрж░рж╛рж░ рж╕рзБржпрзЛржЧ ржкрзЗрзЯрзЗ ржерж╛ржХрзЗред рж╢рж┐ржХрзНрж╖ржХрждрж╛ржХрзЗ ржкрзЗрж╢рж╛ рж╣рж┐рж╕рзЗржмрзЗ ржирж┐рждрзЗ ржЪрж╛ржЗрж▓рзЗ ржПрж░ ржмрж╛ржЗрж░рзЗржУ ржмрж┐ржнрж┐ржирзНржи ржкрж╛ржмрзНрж▓рж┐ржХ ржУ ржкрзНрж░рж╛ржЗржнрзЗржЯ ржнрж╛рж░рзНрж╕рж┐ржЯрж┐ ржПржмржВ ржкрж▓рж┐ржЯрзЗржХржирж┐ржХ ржЗржирзНрж╕ржЯрж┐ржЯрж┐ржЙржЯ ржЧрзБрж▓рзЛрждрзЗ рж▓рзЗржХржЪрж╛рж░рж╛рж░ ржкржжрзЗ ржЬрзЯрзЗржи ржХрж