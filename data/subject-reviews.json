    "content": "<div class=\"separator\" style=\"clear: both; text-align: center;\">\n<a href=\"https://2.bp.blogspot.com/-WHp5VuNlGmI/W-BSdSgnehI/AAAAAAAAArk/bUzInrNr6akodyVHWR5tfgOX5fxdK2foACLcBGAs/s1600/fullimage2-970x400.jpg\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"></a></div><p>тАЬрж╢рж┐ржХрзНрж╖рж╛ ржЬрж╛рждрж┐рж░ ржорзЗрж░рзБржжржгрзНржбтАЭ<br>\nржХржерж╛ржЯрж┐рж░ ржмрж┐рж╢рзНрж▓рзЗрж╖ржг ржХрж░рждрзЗ рж╣ржмрзЗ ржмрж▓рзЗ ржоржирзЗ рж╣ржЪрзНржЫрзЗ ржирж╛редржмрзНржпржХрзНрждрж┐рж░ ржмрж┐ржХрж╛рж╢ ржПржмржВ рж╕ржорж╛ржЬ ржУ ржжрзЗрж╢рзЗрж░ рж╕рж╛ржоржЧрзНрж░рж┐ржХ ржЕржЧрзНрж░ржЧрждрж┐рждрзЗ ржЙржЪрзНржЪ рж╢рж┐ржХрзНрж╖рж╛ ржЧрзБрж░рзБрждрзНржмржкрзВрж░рзНржг ржнрзВржорж┐ржХрж╛ ржкрж╛рж▓ржи ржХрж░рзЗред ржЬрж╛рждрж┐рж░ ржЙржЪрзНржЪрж╛ржХрж╛ржЩрзНржЦрж╛ ржкрзВрж░ржгрзЗрж░ рж▓ржХрзНрж╖рзНржпрзЗ ржЙржЪрзНржЪ рж╢рж┐ржХрзНрж╖рж╛ржЗ ржкрзНрж░ржзрж╛ржи ржЕржмрж▓ржорзНржмржиред рждрж╛ржЗ ржЖржорж╛ржжрзЗрж░ ржжрзЗрж╢рзЗ рж╢рж┐ржХрзНрж╖рж╛ ржХрзНрж╖рзЗрждрзНрж░рзЗ ржЙржЪрзНржЪ рж╢рж┐ржХрзНрж╖рж╛ рж▓рж╛ржнрзЗрж░ рж╕рзБржпрзЛржЧржУ рж░рзЯрзЗржЫрзЗ ржмрзЗрж╢ред<br>\nржпрзЗ ржбрж┐ржЧрзНрж░рж┐ ржмрзНржпрж╛ржЪрзЗрж▓рж░-ржЕржм-ржПржбрзБржХрзЗрж╢ржи ржмрж╛ ржмрж┐ржПржб ржирж╛ржорзЗ ржкрж░рж┐ржЪрж┐рждред ржпржжрж┐ ржЗржЪрзНржЫрж╛ ржерж╛ржХрзЗ рж╢рж┐ржХрзНрж╖рж╛ ржирж┐рзЯрзЗ ржХрж╛ржЬ ржХрж░рж╛рж░ рждржмрзЗ ржПржЗ ржмрж┐рж╖рзЯрзЗ ржкрзЬрждрзЗ ржкрж╛рж░ рждрзБржорж┐ржУред рж╢рж┐ржХрзНрж╖рж╛ ржжрзЗржУрзЯрж╛ рж╣рзЯ ржПржоржи рж╕ржм ржзрж░ржирзЗрж░ ржмрж┐рж╖рзЯ, ржпрж╛ ржЖржзрзБржирж┐ржХ ржмрж┐рж╢рзНржмрзЗ рждрзЛржорж╛рж░ ржкрзНрж░рждрж┐ржЯрж┐ ржкржжржХрзНрж╖рзЗржкрзЗ ржХрж╛ржЬрзЗ рж▓рж╛ржЧржмрзЗред рждрзЛржорж╛ржХрзЗ ржХрзЗржмрж▓ ржПржХржЬржи ржжржХрзНрж╖ рж╢рж┐ржХрзНрж╖рж╛ ржмрж┐рж╢рзЗрж╖ржЬрзНржЮ рж╣рж┐рж╕рзЗржмрзЗ ржЧрзЬрзЗ рждрзБрж▓ржмрзЗ ржирж╛, ржмрж░ржВ ржПржХржЬржи ржнрж╛рж▓ ржорж╛ржирзБрж╖ рж╣рж┐рж╕рзЗржмрзЗ рждрзИрж░рж┐ рж╣рждрзЗ рж╕рж╛рж╣рж╛рзНржпрзНржп ржХрж░ржмрзЗред<br>ржкрж╛ржмрж▓рж┐ржХ ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯ, ржкрзНрж░рж╛ржЗржнрзЗржЯ ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯ рж╕рж╣ ржмрж┐ржнрж┐ржирзНржи ржХрж▓рзЗржЬрзЗ рж░рзЯрзЗржЫрзЗ ржмрж┐ржПржб ржкрзЬрж╛рж░ рж╕рзБржпрзЛржЧред<br>\nЁЯТШЁЯТШрж╢рж┐ржХрзНрж╖рж╛ ржмрж┐ржЬрзНржЮрж╛ржи ржЕржирзБрж╖ржжЁЯТШЁЯТШ<br>ржирзЛржмрж┐ржкрзНрж░ржмрж┐ рждрзЗ рж╢рж┐ржХрзНрж╖рж╛ ржмрж┐ржЬрзНржЮрж╛ржи ржЕржирзБрж╖ржж ржЪрж╛рж▓рзБ рж╣рзЯ ржЧржд ржмржЫрж░ рж╢рж┐ржХрзНрж╖рж╛ ржмрж┐ржнрж╛ржЧ ржЪрж╛рж▓рзБрж░ ржорж╛ржзрзНржпржорзЗред ржЕржирзБрж╖ржж рж╣рж┐рж╕рзЗржмрзЗ ржПржЗ ржкрзНрж░ржержо ржмрж╛ржВрж▓рж╛ржжрзЗрж╢рзЗ ржЪрж╛рж▓рзБ рж╣рзЯ ржПржЗржЯрж┐ред<br>ржврж╛ржХрж╛ ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯ, ржЬржЧржирзНржирж╛рже ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯ ржПржмржВ рж░рж╛ржЬрж╢рж╛рж╣рзА ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯрзЗ ржЕржирзЗржХ ржЖржЧ ржерзЗржХрзЗржЗ ржЖржЗ.ржЗ.ржЖрж░ ржЕрж░рзНржерж╛рзО рж╢рж┐ржХрзНрж╖рж╛ ржУ ржЧржмрзЗрж╖ржгрж╛ ржЗржирж╕рзНржЯрж┐ржЯрж┐ржЙржЯ ржирж╛ржорзЗ ржЪрж╛рж▓рзБ ржЖржЫрзЗред<br>\nЁЯУХЁЯУЦржпрзЗ рж╕ржХрж▓ ржмрж┐рж╖рзЯ ржкрзЬрждрзЗ рж╣ржмрзЗЁЯУХЁЯУЦ<br>ржПржбрзБржХрзЗрж╢ржирзЗ ржкрзЬрждрзЗ ржЪрж╛ржЗрж▓рзЗ ржПржЦрж╛ржирзЗ рж╕рж░рзНржмржкрзНрж░ржержо ржХрж╖рзНржЯ ржХрж░рж╛рж░ ржорж╛ржирж╖рж┐ржХрждрж╛ рждрзИрж░рж┐ ржХрж░рзЗ рждрзЛржорж╛ржХрзЗ ржкрзНрж░ржмрзЗрж╢ ржХрж░рждрзЗ рж╣ржмрзЗред рж╢рж┐ржХрзНрж╖рж╛ ржмрж┐рж╖рзЯрзЗрж░ ржкрж╛рж╢рж╛ржкрж╛рж╢рж┐ рждрзЛржорж╛ржХрзЗ рждрзЛржорж╛рж░ рж╕рзНржЯрзНрж░рж┐ржо ржЕржирзБржпрж╛рзЯрж┐ ржмрж┐рж╖рзЯрж╛ржжрж┐ ржкрзЬрж╛ржирзЛ рж╣ржмрзЗред ржпрзЗ ржпрзЗ ржмрж┐рж╖рзЯ ржкрзЬрж╛ржирзЛ рж╣ржмрзЗржГ-<br>\nржмрж╛ржВрж▓рж╛ ржнрж╛рж╖рж╛, ржЗржВрж░рзЗржЬрж┐ ржнрж╛рж╖рж╛, ржоржирзЛржмрж┐ржЬрзНржЮрж╛ржи, ржжрж░рзНрж╢ржи, ict, ржкржжрж╛рж░рзНржержмрж┐ржЬрзНржЮрж╛ржи, рж░рж╕рж╛рзЯржи, ржЧржгрж┐ржд ржХрж┐ржВржмрж╛ ржЬрзАржмржмрж┐ржЬрзНржЮрж╛ржи ржЗрждрзНржпрж╛ржжрж┐ред<br>ржП ржЫрж╛рзЬрж╛ржУ ржХрж┐ ржнрж╛ржмрзЗ рждрзБржорж┐ рж╢рж┐ржХрзНрж╖ржХржжрзЗрж░ ржкрзНрж░рж╢рж┐ржХрзНрж╖ржг ржжрж┐ржмрзЗ, ржХрж┐ ржнрж╛ржмрзЗ ржХрзНрж▓рж╛рж╕ ржирж┐ржмрзЗ рждрж╛рж░ ржЙржкрж░ рж╣рж╛рждрзЗ ржХрж▓ржорзЗ рж╢рж┐ржХрзНрж╖рж╛ ржжрзЗрзЯред ржХрж┐ ржнрж╛ржмрзЗ рждрзБржорж┐ ржкрзНрж░рж╢рж╛рж╕ржирж┐ржХ ржХрж╛ржЬ ржХрж░ржмрзЗ рждрж╛рж░ ржзрж╛рж░ржирж╛ ржжрж┐ржмрзЗ тАЬрж╢рж┐ржХрзНрж╖рж╛ ржкрзНрж░рж╢рж╛рж╕ржитАЭ ржмрж┐ржнрж╛ржЧ<br>\nЁЯТ░ЁЯТ░ржЬржм рж╕рзЗржХрзНржЯрж░ЁЯТ░ЁЯТ░<br>ржкрзЬрж╛рж▓рзЗржЦрж╛ рж╢рзЗрж╖ ржХрж░рзЗ ржПржмрж╛рж░ ржЖржорж░рж╛ ржЖрж╕рж┐ ржЬржм ржЕржкрж░ржЪрзБржирж┐ржЯрж┐ рж╕ржорзНржкрж░рзНржХрзЗ, ржпрзЗржЯрж╛ рж╕ржмржЪрж╛ржЗрждрзЗ ржмрзЗрж╢рж┐ ржЗржорзНржкрж░ржЯрзЗржирзНржЯ ржЖрж░ ржХрж┐ред ржЪрж╛ржХрзБрж░рзАрж░ ржмрж╛ржЬрж╛рж░рзЗржУ ржЖржЧрзНрж░рж╣рзЗрж░ ржХрзЗржирзНржжрзНрж░ржмрж┐ржирзНржжрзБрждрзЗржУ ржмрж░рзНрждржорж╛ржи рж╕ржорзЯрзЗ рж╢рж┐ржХрзНрж╖рж╛ ржУ ржЧржмрзЗрж╖ржгрж╛ ржЙржкрж░рзЗрж░ рж╕рж╛рж░рзАрждрзЗред<br>ржкрзЬрж╛рж╢рзБржирж╛ ржпрзЗрж╣рзЗрждрзБ рж╢рж┐ржХрзНрж╖рж╛ ржирж┐рзЯрзЗ рждрж╛ржЗ рж╢рж┐ржХрзНрж╖рж╛ржмрж┐рж╖рзЯржХ рж╕ржм ржкрзНрж░рждрж┐рж╖рзНржарж╛ржирзЗ рждрзЛржорж╛рж░ ржерж╛ржХржмрзЗ ржПржХржХ рж░рж╛ржЬрждрзНржмред<br>\nржЗржЙ ржЖрж░ рж╕рж┐ ржЗржирзНрж╕ржЯрзНрж░рж╛ржХрзНржЯрж░, ржкрж┐ржЯрж┐рзЯрж╛ржЗ ржЗржирзНрж╕ржЯрзНрж░рж╛ржХрзНржЯрж░, ржерж╛ржирж╛ рж╢рж┐ржХрзНрж╖рж╛ ржЕржлрж┐рж╕рж╛рж░, ржЙржкржЬрзЗрж▓рж╛ ржПржХрж╛ржбрзЗржорж┐ржХ рж╕рзБржкрж╛рж░ржнрж╛ржЗржЬрж╛рж░, ржбрж┐рж╕рзНржЯрзНрж░рж┐ржХрзНржЯ ржЯрзНрж░рзЗржирж┐ржВ ржХрзЛ ржЕрж░рзНржбрж┐ржирзЗржЯрж░, ржмрзНржпрж╛ржВржХрж╛рж░ (рж╕рж░ржХрж╛рж░рж┐ ржУ ржкрзНрж░рж╛ржЗржнрзЗржЯ), ржмрж╛ржВрж▓рж╛ржжрзЗрж╢ ржмрзНржпрж╛ржВржХ, ржмрж┐ржнрж┐ржирзНржи рж╕рзНржмрж╛рзЯрждрзНржмрж╢рж╛рж╕рж┐ржд рж╕рж░ржХрж╛рж░рж┐ ржкрзНрж░рждрж┐рж╖рзНржарж╛ржирзЗрж░ рж╕рж╣ржХрж╛рж░рзА ржмрзНржпржмрж╕рзНржерж╛ржкржХ ржУ ржЕржирзНржпрж╛ржирзНржп, ржмрж┐ржнрж┐ржирзНржи ржПржиржЬрж┐ржУ рждрзЗ ржХрж╛рж░рж┐ржХрзБрж▓рж╛ржо ржбрзЗржнрзЗрж▓ржкрж╛рж░, рж▓рж╛рж░рзНржирж┐ржВ ржорзНржпрж╛ржЯрзЗрж░рж┐рзЯрж╛рж▓ рж╕рзНржкрзЗрж╢рж╛рж▓рж┐рж╕рзНржЯ, рж░рж┐рж╕рж╛рж░рзНржЪрж╛рж░, ржкрзНрж░рж╛ржЗржнрзЗржЯ-ржкрж╛ржмрж▓рж┐ржХ ржнрж╛рж░рзНрж╕рж┐ржЯрж┐ рж▓рзЗржХржЪрж╛рж░рж╛рж░ ржХрзНржпрж╛ржбрж╛рж░-ржиржи ржХрзНржпрж╛ржбрж╛рж░ ржкрзЛрж╕рзНржЯ ржмрж╛