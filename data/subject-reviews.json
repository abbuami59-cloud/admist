    "slug": "%e0%a6%95%e0%a7%8d%e0%a6%b0%e0%a6%bf%e0%a6%ae%e0%a6%bf%e0%a6%b2%e0%a7%8b%e0%a6%9c%e0%a6%bf-%e0%a6%a8%e0%a6%bf%e0%a7%9f%e0%a7%87-%e0%a6%95%e0%a7%87%e0%a6%a8-%e0%a6%aa%e0%a7%9c%e0%a6%ac%e0%a7%8b",
    "title": "ржХрзНрж░рж┐ржорж┐рж▓рзЛржЬрж┐ ржирж┐рзЯрзЗ ржХрзЗржи ржкрзЬржмрзЛ?",
    "content": "<p class=\"wp-block-paragraph\">ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржирж┐рзЯрзЗ ржХрзЗржи ржкрзЬржмрзЗржи??</p><p class=\"wp-block-paragraph\">ржЕржкрж░рж╛ржз ржирж┐рзЯрзЗ ржкрзЬрж╛рж╢рзЛржирж╛! ржмрж┐рж╖рзЯржЯрж┐ ржнрж╛ржмрждрзЗржЗ ржЕржмрж╛ржХ рж▓рж╛ржЧрзЗредржЕржкрж░рж╛ржз ржХржерж╛ржЯрж┐ рж╢рзБржирж╛рж░ ржкрж░ ржЖржорж╛ржжрзЗрж░ ржоржзрзНржпрзЗ ржХрзМрждрзБрж╣рж▓ ржЕржирзЗржХржЯрж╛ржЗ ржмрзЗрзЬрзЗ ржпрж╛рзЯредржоржирзЗрж░ ржЕржЬрж╛ржирзНрждрзЗржЗ рж░рж╣рж╕рзНржпрзЗрж░ ржбрж╛рж▓ржкрж╛рж▓рж╛ ржЧржЬрж╛рждрзЗ ржерж╛ржХрзЗредржЖрж░ ржпржжрж┐ рж╣рзЯ ржЕржкрж░рж╛ржз ржирж┐рзЯрзЗ ржкрзЬрж╛рж╢рзЛржирж╛ рждржЦржи рждрзЛ ржХржерж╛ржЗ ржирзЗржЗред<br>ржЕржкрж░рж╛ржз ржХрж┐ (Crime): ржЕржкрж░рж╛ржз рж╣рж▓ ржПржХ ржзрж░ржирзЗрж░ ржЕрж╕рзНржмрж╛ржнрж╛ржмрж┐ржХ ржЖржЪрж░ржг ржпрж╛ рж╕ржорж╛ржЬ ржУ ржкрзНрж░ржЪрж▓рж┐ржд ржЖржЗржи ржХрж░рзНрждрзГржХ рж╕рзНржмрзАржХрзГржд ржирзЯредрж╕ржорж╛ржЬ ржмрж┐ржЬрзНржЮрж╛ржирзА ржХрзЛржирж┐ржЧ ржПрж░ ржорждрзЗ тАЬрж╕ржорж╛ржЬ ржмрж╛ ржЧрзЛрж╖рзНржарзА ржжрзНржмрж╛рж░рж╛ ржжрзГрзЭржнрж╛ржмрзЗ ржЕрж╕ржорж░рзНржерж┐ржд ржмрж╛ ржирж┐рж╖рж┐ржжрзНржз ржорж╛ржиржм ржЖржЪрж░ржгржЗ рж╣рж▓ ржЕржкрж░рж╛ржзредтАЭ</p><p class=\"wp-block-paragraph\">ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржХрж┐(Criminology) :<br>ржЖржорж╛ржжрзЗрж░ рж╕ржорж╛ржЬрзЗ ржкрзНрж░рждрж┐ржирж┐рзЯрждржЗ ржмрж┐ржнрж┐ржирзНржи ржЕржкрж░рж╛ржз рж╕ржВржЧржарж┐ржд рж╣ржЪрзНржЫрзЗредрж╕ржорзЯрзЗрж░ ржкрж░рж┐ржмрж░рзНрждрзЗрж░ рж╕рж╛ржерзЗ рж╕рж╛ржерзЗ ржЕржкрж░рж╛ржзрзЗрж░ ржзрж░ржи ржУ ржкрж╛рж▓рзНржЯрзЗ ржпрж╛ржЪрзНржЫрзЗредржЧрзБржкрзНрждрж╣рждрзНржпрж╛,ржкрзНрж░ржХрж╛рж╢рзНржпрзЗ ржХрзБржкрж┐рзЯрзЗ ржХрж┐ржВржмрж╛ ржЧрзБрж▓рж┐ ржХрж░рзЗ рж╣рждрзНржпрж╛ рж╕ржирзНрждрзНрж░рж╛рж╕,ржЧрзБржо,ржзрж░рзНрж╖ржг ржирж╛рж░рзА ржУ ржорж╛ржиржм ржкрж╛ржБржЪрж╛рж░,ржжрзБрж░рзНржирзАрждрж┐,рж╕рзНржмржЬржиржкрзНрж░рзАрждрж┐, ржорж╛ржжржХ,ржЬржЩрзНржЧрж┐ рж╣рж╛ржорж▓рж╛, рж╕рж╛ржЗржмрж╛рж░ рж╕рж╣ ржирж╛ржирж╛ ржЕржкрж░рж╛ржз ржжрж┐ржи ржжрж┐ржи ржмрзЗрзЬрзЗржЗ ржЪрж▓ржЫрзЗредржПрж╕ржм ржЕржкрж░рж╛ржзржорзВрж▓ржХ ржХрж╛рж░рзНржпржХрж▓рж╛ржк ржирж┐рзЯрзЗ ржЕржкрж░рж╛ржзрзАржжрзЗрж░ ржЖржЪрж░ржг ржЕржирзБрж╕ржирзНржзрж╛ржи, ржЕржкрж░рж╛ржзрзЗрж░ рж╕рж╛ржорж╛ржЬрж┐ржХ ржирж┐рзЯржирзНрждрзНрж░ржг ржмрж┐ржЪрж╛рж░, ржмрж┐рж╢рзНрж▓рзЗрж╖ржг, ржкрзНрж░рждрж┐ржХрж╛рж░ ржУ ржХрж░рзНржоржкржирзНржерж╛ ржирж┐рж░рзНржзрж╛рж░ржг ржирж┐рзЯрзЗ ржЕржзрзНржпрзЯржиржХрзЗ ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржмрж▓рзЗред</p><p class=\"wp-block-paragraph\">ржмрж╛ржВрж▓рж╛ржжрзЗрж╢рзЗ ржкржжржпрж╛рждрзНрж░рж╛:<br>ржмрж╛ржВрж▓рж╛ржжрзЗрж╢рзЗ рзирзжрзжрзк рж╕рж╛рж▓рзЗ ржоржУрж▓рж╛ржирж╛ ржнрж╛рж╕рж╛ржирзА ржмрж┐ржЬрзНржЮрж╛ржи ржкрзНрж░ржпрзБржХрзНрждрж┐ ржУ ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯрзЗрж░ ржорж╛ржзрзНржпрзЗржорзЗ ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржмрж┐ржнрж╛ржЧ ржпрж╛рждрзНрж░рж╛ рж╢рзБрж░рзБ рж╣рж▓рзЗ ржУ ржЙржирзНржиржд ржмрж┐рж╢рзНржмрзЗ ржмрж╣рзБ ржЖржЧрзЗржЗ ржмрж┐рж╖рзЯржЯрж┐ рж╕рзНржерж╛ржи ржХрж░рзЗ ржирж┐рзЯрзЗржЫрзЗредржврж╛ржХрж╛ ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯрзЗ рзирзжрззрзй-рзирзжрззрзк рж╕рзЗрж╢ржирзЗ ржмрж┐рж╖рзЯржЯрж┐ ржЪрж╛рж▓рзБ ржХрж░рж╛рж░ ржорж╛ржзрзНржпржорзЗ ржирждрзБржи ржорж╛рждрзНрж░рж╛ ржкрзЗрзЯрзЗржЫрзЗржиредржПржЦрж╛ржи ржерзЗржХрзЗ ржмрзНржпрж╛ржЪрзЗрж▓рж░ ржЕржм ржЕрж░рзНржирж╛рж╕, ржпрзЗ ржХрзЛржи ржмрж┐рж╖рзЯрзЗ ржкрзЬрзЗ ржорж╛рж╕рзНржЯрж╛рж░рзНрж╕ ржХрж░рж╛рж░ рж╕рж╛ржерзЗ ржерж╛ржХржЫрзЗ ржкрж┐ржПржЗржбрж┐ ржУ ржПржоржлрж┐рж▓ ржХрж░рж╛рж░ ржжрж╛рж░рзБржи рж╕рзБржпрзЛржЧред</p><p class=\"wp-block-paragraph\">рж╢рж┐ржХрзНрж╖ржХ рж╣рж┐рж╕рж╛ржмрзЗ ржпрж╛рж░рж╛:<br>ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐рж░ ржкржжржЪрж╛рж░ржгрж╛ ржмрзЗрж╢ ржХрж┐ржЫрзБ ржжрж┐ржи ржЖржЧрзЗ рж╢рзБрж░рзБ рж╣рж▓рзЗ ржУ ржПржЦрж╛ржирзЗ ржХрзНрж▓рж╛рж╕ ржирзЗржи ржжрзЗрж╢ рж╕рзЗрж░рж╛ ржмрзНржпрж╛ржХрзНрждрж┐рж░рж╛редрж╢рж┐ржХрзНрж╖ржХ рж╣рж┐рж╕рж╛ржмрзЗ ржжрзЗржЦрж╛ ржпрж╛ржмрзЗ ржЕржкрж░рж╛ржзржмрж┐ржЬрзНржЮрж╛ржирзА ржб.ржЬрж┐рзЯрж╛ рж░рж╣ржорж╛ржи ,рж╢рж╛рж╣рж░рж┐рзЯрж╛ ржЖржлрж░рж┐ржи, ржЙржорзНржорзЗ ржУрзЯрж╛рж░рж╛ ржорж┐рж╢рзБ,ржорж╛рж╣ржлрзБржЬрзБрж▓ рж╣ржХ ржорж╛рж░ржЬрж╛ржи,рж░рзЗрж╣ржирзБржорж╛ рж╕рж┐ржжрзНржжрж┐ржХ, ржПржмрж┐ржПржо ржирж╛ржЬржорзБрж╕ рж╕рж╛ржХрж┐ржмред</p><p class=\"wp-block-paragraph\">ржЧрзЗрж╕рзНржЯржЯрж┐ржЪрж╛рж░ рж╣рж┐рж╕рзЗржмрзЗ ржХрзНрж▓рж╛рж╕ ржирзЗржи CTTC рж╢рж╛ржЦрж╛рж░ ржкрзНрж░ржзрж╛ржи ржбрж┐ржЖржЗржЬрж┐ ржоржирж┐рж░рзБрж▓ ржЗрж╕рж▓рж╛ржо,ржлрж░рзЗржирж╕рж┐ржи рж╢рж┐ржХрзНрж╖ржХ ржб.ржорж╛рж╣ржлрзБржЬрзБрж▓ рж╣ржХ рж╕рзБржкржг, ржХрзНрж▓рж┐ржирж┐ржХрж╛рж▓ рж╕рж╛ржЗржХрзЛрж▓ржЬрж┐рж╕рзНржЯ ржб.ржорж╛рж╣ржлрзБржЬрж╛ ржЦрж╛ржиржо рж╕рж╣ ржЖржЗржи рж╢рзГржЩрзНржЦрж▓рж╛ ржмрж╛рж╣рж┐ржирзАрж░ ржЕржирзЗржХ ржКрж░рзНржзрзНржмрждржи ржХрж░рзНржоржХрж░рзНрждрж╛рж░рж╛ред</p><p class=\"wp-block-paragraph\">ржХрзЛрж░рзНрж╕ рж╕ржорзВрж╣ржГржорзВрж▓ржд ржЖржЗржи,ржирзГржмрж┐ржЬрзНржЮрж╛ржи ,рж╕рзЛрж╕рж┐ржУрж▓ржЬрж┐, ржХрзНрж░рж┐ржорж┐ржирж╛рж▓ рж╕рж╛ржЗржХрзЛрж▓ржЬрж┐, ржкрж░рж┐рж╕ржВржЦрзНржпрж╛ржи,ржЬрзЗржирзЛрж╕рж╛ржЗржб рж╕рзНржЯрзНржпрж╛ржбрж┐,рж╕рж┐ржХрж┐ржЙрж░рж┐ржЯрж┐ ржорзНржпрж╛ржирзЗржЬржорзЗржирзНржЯ, ржкрзБрж▓рж┐рж╕рж┐ржВ,ржкрж▓рж┐ржЯрж┐ржХрзНржпрж╛рж▓ ржЗржХрзЛржиржорж┐ ржПржирзНржб ржХрзНрж░рж╛ржЗржо, ржлрж░рзЗржирж╕рж┐ржХ ржЗрждрзНржпрж╛ржжрж┐ ржмрж┐рж╖рзЯ ржЧрзБрж▓рзЛрж░ рж╕рж╛ржерзЗ рж╕ржорзНржкрж░рзНржХрж┐ржд ржХрж░рзЗ Criminology ржкрзЬрж╛ржирзЛ рж╣рзЯред</p><p class=\"wp-block-paragraph\">ржЖрж╕ржи рж╕ржВржЦрзНржпрж╛ржГ ржмрж┐ржЬрзНржЮрж╛ржи +ржорж╛ржиржмрж┐ржХ+ржмрж┐ржЬржирзЗрж╕ рж╕рзНржЯрзНржпрж╛ржбрж┐рж╕(рзйрзл+рзирзж+рззрзж)</p><p class=\"wp-block-paragraph\">ржлрж▓рж╛ржлрж▓ ржХрзЗржоржи рж╣рзЯржГ (CGPA)рж╕рж╛ржорж╛ржЬрж┐ржХ ржмрж┐ржЬрзНржЮрж╛ржи ржЕржирзБрж╖ржжрзЗрж░ ржоржзрзНржпрзЗ рждрзБрж▓ржирж╛ржорзВрж▓ржХ ржлрж▓рж╛ржлрж▓ ржнрж╛рж▓ ред ржкрзНрж░ржержо ржжрзБржЯрж┐ ржмрзНржпрж╛ржЪрзЗрж░ ржЧрзЬ CGPA ржкрзНрж░рж╛рзЯ рзй.рзлрзж ржПрж░ ржХрж╛ржЫрж╛ржХрж╛ржЫрж┐ред</p><p class=\"wp-block-paragraph\">рж╕ржмржЪрзЗрзЯрзЗ ржнрж╛рж▓ ржжрж┐ржХржГ ржЖржзрзБржирж┐ржХ рж╕рзБрж╕ржЬрзНржЬрж┐ржд ржХрзНрж▓рж╛рж╕ рж░рзБржоред</p><p class=\"wp-block-paragraph\">ржХрзНржпрж╛рж░рж┐рзЯрж╛рж░ ржЧржаржи:<br>ржмрж╛ржВрж▓рж╛ржжрзЗрж╢рзЗ ржмрж┐ржнрж╛ржЧржЯрж┐ ржирждрзБржи ржЪрж╛рж▓рзБ рж╣рж▓рзЗржУ ржЗрждрж┐ржоржзрзНржпрзЗ ржмрзНржпрж╛ржкржХ рж╕рж╛рзЬрж╛ ржЬрж╛ржЧрж┐рзЯрзЗржЫрзЗредржмрж┐рж╕рж┐ржПрж╕ ржкрзБрж▓рж┐рж╢ ржХрзНржпрж╛ржбрж╛рж░ ржпрж╛ржжрзЗрж░ ржкрзНрж░ржержо ржкржЫржирзНржж рждрж╛рж░рж╛ ржПржЗ ржмрж┐ржнрж╛ржЧрзЗ ржкрзЬрждрзЗ ржкрж╛рж░рзЗржи редржП ржЫрж╛рзЬрж╛ ржмрж┐ржнрж┐ржирзНржи ржЧрзЛрзЯрзЗржирзНржжрж╛ рж╕ржВрж╕рзНржерж╛ ржпрзЗржоржи ржПржи,ржПрж╕, ржЖржЗ,ржкрзБрж▓рж┐рж╢рзЗрж░ ржПрж╕ ржмрж┐,ржбрж┐ржмрж┐, рж╕рж┐ржЖржЗржбрж┐,ржбрж┐ржЬрзЗржПржл ржЖржЗ, ржЬрзЗрж▓ржЦрж╛ржирж╛рж░ ржЬрзЗрж▓рж╛рж░ рж╕рж╣ ржирж╛ржирж╛ ржЪрж╛ржХрж░рж┐рж░ ржХрзНрж╖рзЗрждрзНрж░рзЗ ржПржЗ ржЪрж╛ржХрж░рж┐ ржЖржкржирж╛рж░ ржкрже ржЪрж▓рж╛рж░ рж╕рж╣рж╛рзЯржХ ржнрзВржорж┐ржХрж╛ ржкрж╛рж▓ржи ржХрж░ржмрзЗред ржмрзЗрж╕рж░ржХрж╛рж░рзА ржЪрж╛ржХрж░рж┐, ржжрзЗрж╢рзА ржмрж┐ржжрзЗрж╢рзА ржмрж┐ржнрж┐ржирзНржи ржПржиржЬрж┐ржУ рждрзЗ ржХрж╛ржЬ ржХрж░рж╛рж░ ржерж╛ржХржЫрзЗ ржмрж┐рж╢рж╛рж▓ рж╕рзБржпрзЛржЧредрждрж╛ржЫрж╛рзЬрж╛ рж╕рж╛ржорж╛ржЬрж┐ржХ ржмрж┐ржЬрзНржЮрж╛ржи ржЕржирзБрж╖ржжрзЗрж░ ржмрж┐рж╖рзЯ ржЧрзБрж▓рзЛ ржкрзЬрзЗ ржпрзЗ ржзрж░ржирзЗрж░ ржХрж░рзНржоржХрзНрж╖рзЗрждрзНрж░ рж░рзЯрзЗржЫрзЗ рждрж╛рж░ рж╕ржм ржкрзНрж░рж╛рзЯ ржЧрзБрж▓рзЛрждрзЗ ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржзрж╛ржкрж┐рзЯрзЗ ржмрзЗрзЬрж╛ржмрзЗред<br>рждрж╛рж╣рж▓рзЗ ржЖрж░ ржжрзЗрж░рзА ржХрзЗржи, ржЕржкрж░рж╛ржз,рж░рж╣рж╕рзНржп рж╕ржорзНржкрж░рзНржХрзЗ ржпрж╛ржжрзЗрж░ рждрзБржорзБрж▓ ржЕрж╛ржЧрзНрж░рж╣, ржпрж╛рж░рж╛ ржЧрждрж╛ржирзБржЧрждрж┐ржХ ржмрж┐рж╖рзЯрзЗрж░ ржмрж╛ржЗрж░рзЗ ржкрзЬрждрзЗ ржЪрж╛ржи рждрж╛рж░рж╛ ржЕржмрж╢рзНржпржЗ рж╕рзНржорж╛рж░рзНржЯред ржЖрж░ рж╕рзНржорж╛рж░рзНржЯржжрзЗрж░ ржкрзНрж░ржержо ржкржЫржирзНржж ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ред<br>ржЖржорж┐ ржкрзЬржЫрж┐ ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржЖржкржирж┐ ржкрзЬржЫрзЗржи рждрзЛ?</p><p class=\"wp-block-paragraph\">ржЕржнрж┐ржЬрж┐рзО рж╕рж░ржХрж╛рж░<br>ржХрзНрж░рж┐ржорж┐ржирзЛрж▓ржЬрж┐ ржбрж┐ржкрж╛рж░рзНржЯржорзЗржирзНржЯ<br>ржврж╛ржХрж╛ ржмрж┐рж╢рзНржмржмрж┐ржжрзНржпрж╛рж▓рзЯред</p><h1 class=\"wp-block-heading\">&nbsp;</h1><p class=\"wp-block-paragraph\">&nbsp;</p><div class=\"post-views content-post post-3679 entry-meta load-static\" data-pvc-type=\"post\" data-pvc-id=\"3679\">\n<span class=\"post-views-icon dashicons dashicons-chart-bar\"></span> <span class=\"post-views-label\">рж▓рзЗржЦрж╛ржЯрж┐рж░ ржкрж╛ржаржХ рж╕ржВржЦрзНржпрж╛:</span> <span class=\"post-views-count\">1,658</span></div>",
